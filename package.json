{
  "dependencies": {
    "@angular/aria": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.63.0",
    "@types/inquirer": "^9.0.7",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "^6.2.6",
    "inquirer": "^12.0.0",
    "jsdom": "^30.0.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.8.1",
    "simple-git": "^3.27.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "name": "newsletter-template-editor",
  "packageManager": "npm@11.13.0",
  "private": true,
  "scripts": {
    "build": "ng build",
    "gate:compare": "esbuild tools/gate/compare.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/gate/compare.mjs && node node_modules/.cache/gate/compare.mjs",
    "maintenance:branches": "tsx --tsconfig tsconfig.json maintenance/select-and-delete-local-branches.ts",
    "ng": "ng",
    "prebuild": "node scripts/write-app-version.mjs",
    "prestart": "node scripts/write-app-version.mjs",
    "pretest": "node scripts/write-app-version.mjs",
    "release:version": "node scripts/release-version.mjs",
    "start": "ng serve",
    "test": "ng test",
    "test:bdd": "bddgen --config bdd.config.ts && playwright test --config bdd.config.ts",
    "test:bdd:gen": "bddgen --config bdd.config.ts",
    "test:coverage": "npm test -- --watch=false --coverage",
    "version:write": "node scripts/write-app-version.mjs",
    "watch": "ng build --watch --configuration development"
  },
  "version": "0.5.0"
}
